; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Prototyping Game Systems"
config/description="Prototyping some custom game systems/implementations. The end goal is to have multiple systems set up that I can \"drag n drop\" into any project to jumpstart it. The main systems I'm working on currently include:
	- Managers: multiple singleton nodes that are in charge of various elements of the game, like scenes, settings, etc.
	- PersistantSettings: a streamlined way to create controllable settings that can be saved to and loaded from a config file.

So far, the manager system is coming along nicely, and the settings system is really cooking. PersistantSettings are extremely easy to use and require very little tedious work. Previously, I'd have to add a whole bunch of information to some code and even write a custom script for every single setting. Now, I just drop in a PersistantSetting node and the only code I have to write has to do with using the setting once it's been set, which is a simple match statement. It's super nice to have."
run/main_scene="uid://br4s2dvy61x6f"
config/features=PackedStringArray("4.5")
config/icon="res://icon.png"

[autoload]

gGameManager="*res://managers/game_manager.gd"
gSettingsManager="*res://managers/settings_manager.gd"
gSceneManager="*res://managers/scene_manager.gd"
gUIManager="*res://managers/ui_manager.tscn"
gPlayerData="*res://scenes/actor/player/player_data.gd"
gDebugger="*res://ui/debugger.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

